* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.ps1 text eol=crlf
*.sh text eol=lf

# Preserve upstream bytes: configs/data.json checks their SHA-256 values.
/data/raw/* -text whitespace=cr-at-eol
/data/processed/*.csv text eol=lf

# Keep the published final NB outputs byte-identical to the training runner.
/results/naive_bayes_test/*.csv -text whitespace=cr-at-eol

# Preserve official-message bytes in the selected new-model outputs as well.
/results/neural_test/*/*.csv -text whitespace=cr-at-eol
/results/transformer_test/*/*.csv -text whitespace=cr-at-eol

# Keep the published classical test outputs byte-identical to the runner as well.
/results/logistic_regression_test/*.csv -text whitespace=cr-at-eol
/results/linear_svm_test/*.csv -text whitespace=cr-at-eol
